  Set e22 = f2d.CreateLine(16, 26.5, 18.5, 26.5)
  e22.StartPoint = p18
  e22.EndPoint = p19
  Set e23 = f2d.CreateLine(18.5, 26.5, 18.5, 75.5)
  e23.StartPoint = p19
  e23.EndPoint = p20
  Set e24 = f2d.CreateLine(18.5, 75.5, 16, 75.5)
  e24.StartPoint = p20
  e24.EndPoint = p21
  Set e25 = f2d.CreateLine(16, 75.5, 16, 26.5)
  e25.StartPoint = p21
  e25.EndPoint = p18
  cst.AddMonoEltCst 10, part1.CreateReferenceFromObject(e22)  ' catCstTypeHorizontality / Verticality
  cst.AddMonoEltCst 13, part1.CreateReferenceFromObject(e23)  ' catCstTypeHorizontality / Verticality
  cst.AddMonoEltCst 10, part1.CreateReferenceFromObject(e24)  ' catCstTypeHorizontality / Verticality
  cst.AddMonoEltCst 13, part1.CreateReferenceFromObject(e25)  ' catCstTypeHorizontality / Verticality
  Set k26 = cst.AddMonoEltCst(5, part1.CreateReferenceFromObject(e22))  ' catCstTypeLength
  rels.CreateFormula "F_Rail_L_L26", "", k26.Dimension, "abs( ( Y_OUTER - WALL + OVERLAP ) - ( Y_RIB_TIP ) )"
  Set k27 = cst.AddMonoEltCst(5, part1.CreateReferenceFromObject(e23))  ' catCstTypeLength
  rels.CreateFormula "F_Rail_L_L27", "", k27.Dimension, "abs( ( RAIL_Z1 ) - ( RAIL_Z0 ) )"
  sk17.CloseEdition
  part1.InWorkObject = sk17
  part1.Update
  Set ft28 = sf.AddNewPad(sk17, 0.5)
  ft28.IsSymmetric = True
  ft28.Name = "Rail_L"
  rels.CreateFormula "F_Rail_L_half", "", ft28.FirstLimit.Dimension, "abs( ( RAIL_W ) - ( 0mm ) ) / 2"
  part1.Update
  If Err.Number <> 0 Then log = log & "FAILED: " & stepName & " (" & Err.Description & ")" & vbCrLf: nFail = nFail + 1: Err.Clear
  stepName = "pad Rail_R"
  Set pl29 = hsf.AddNewPlaneOffset(part1.CreateReferenceFromObject(org.PlaneYZ), 30.5, False)
  hb.AppendHybridShape pl29
  pl29.Name = "Plane_Rail_R"
  rels.CreateFormula "F_Plane_Rail_R", "", pl29.Offset, "( ( WIDTH - RAIL_W ) + ( WIDTH ) ) / 2"
  part1.InWorkObject = hb
  part1.Update
  part1.InWorkObject = body1
  Set sk30 = body1.Sketches.Add(part1.CreateReferenceFromObject(pl29))
  sk30.Name = "Sketch_Rail_R"
  ax(0) = 30.5

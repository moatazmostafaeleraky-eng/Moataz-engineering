  path = InputBox("Save the part as (.CATPart). Leave empty to skip.", "Save", "C:\Temp\cover_example.CATPart")
  If path <> "" Then doc.SaveAs path
End Sub

Function IIf(c, a, b)
  If c Then IIf = a Else IIf = b
End Function

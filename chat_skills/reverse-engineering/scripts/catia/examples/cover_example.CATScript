Language="VBSCRIPT"
' cover_example: generated from a feature spec by catia_macro.py (reverse-engineering skill).
' Builds the part as a native CATIA V5 feature tree and saves it as .CATPart.
' Not executed where it was generated: run it in CATIA and check the log at the end.

Sub CATMain()
  Dim log, stepName, nFail, ax(8)
  log = "": nFail = 0: stepName = "start"
  On Error Resume Next
  Set doc = CATIA.Documents.Add("Part")
  Set part1 = doc.Part
  doc.Product.PartNumber = "cover_example"
  Set body1 = part1.MainBody
  Set params = part1.Parameters
  Set rels = part1.Relations
  Set hsf = part1.HybridShapeFactory
  Set sf = part1.ShapeFactory
  Set org = part1.OriginElements
  Set hb = part1.HybridBodies.Add()
  hb.Name = "RE_Planes"
  If Err.Number <> 0 Then log = log & "FAILED: " & stepName & " (" & Err.Description & ")" & vbCrLf: nFail = nFail + 1: Err.Clear
  stepName = "parameters"
  Set prm = params.CreateDimension("WIDTH", "LENGTH", 31)
  Set prm = params.CreateDimension("Z_BOTTOM", "LENGTH", 11.5)
  Set prm = params.CreateDimension("Z_TOP", "LENGTH", 77)
  Set prm = params.CreateDimension("Y_OUTER", "LENGTH", 20)
  Set prm = params.CreateDimension("WALL", "LENGTH", 2)
  Set prm = params.CreateDimension("TOP_EDGE_R", "LENGTH", 0.5)
  Set prm = params.CreateDimension("Y_RIB_TIP", "LENGTH", 16)
  Set prm = params.CreateDimension("OVERLAP", "LENGTH", 0.5)
  Set prm = params.CreateDimension("RAIL_W", "LENGTH", 1)
  Set prm = params.CreateDimension("RAIL_Z0", "LENGTH", 26.5)
  Set prm = params.CreateDimension("RAIL_Z1", "LENGTH", 75.5)
  Set prm = params.CreateDimension("RIB_W", "LENGTH", 0.8)
  Set prm = params.CreateDimension("RIB_X1", "LENGTH", 7)
  Set prm = params.CreateDimension("RIB_X2", "LENGTH", 24)
  Set prm = params.CreateDimension("RIB_Z1", "LENGTH", 56.5)
  Set prm = params.CreateDimension("LIP_Z1", "LENGTH", 76.5)
  Set prm = params.CreateDimension("HOOK_X0", "LENGTH", 12.5)
  Set prm = params.CreateDimension("HOOK_X1", "LENGTH", 18.5)
  Set prm = params.CreateDimension("HOOK_Y1", "LENGTH", 17)
  Set prm = params.CreateDimension("HOOK_Z0", "LENGTH", 68.5)
  Set prm = params.CreateDimension("HOOK_Z1", "LENGTH", 73)
  Set prm = params.CreateDimension("HOOK_LEG_W", "LENGTH", 1)
  Set prm = params.CreateDimension("BUMP_W", "LENGTH", 3)
  Set prm = params.CreateDimension("BUMP_X1", "LENGTH", 6)
  Set prm = params.CreateDimension("BUMP_X2", "LENGTH", 25)
  Set prm = params.CreateDimension("CORE_W", "LENGTH", 1)
  Set prm = params.CreateDimension("LATCH_X0", "LENGTH", 12.5)
  Set prm = params.CreateDimension("LATCH_X1", "LENGTH", 18.5)
  If Err.Number <> 0 Then log = log & "FAILED: " & stepName & " (" & Err.Description & ")" & vbCrLf: nFail = nFail + 1: Err.Clear
  stepName = "pad Plate"
  Set pl1 = hsf.AddNewPlaneOffset(part1.CreateReferenceFromObject(org.PlaneYZ), 15.5, False)
  hb.AppendHybridShape pl1
  pl1.Name = "Plane_Plate"
  rels.CreateFormula "F_Plane_Plate", "", pl1.Offset, "( ( 0mm ) + ( WIDTH ) ) / 2"
  part1.InWorkObject = hb
  part1.Update
  part1.InWorkObject = body1
  Set sk2 = body1.Sketches.Add(part1.CreateReferenceFromObject(pl1))
  sk2.Name = "Sketch_Plate"
  ax(0) = 15.5
  ax(1) = 0
  ax(2) = 0
  ax(3) = 0
  ax(4) = 1
  ax(5) = 0
  ax(6) = 0
  ax(7) = 0
  ax(8) = 1
  sk2.SetAbsoluteAxisData ax
  Set f2d = sk2.OpenEdition()
  Set cst = sk2.Constraints
  Set p3 = f2d.CreatePoint(18, 11.5)
  Set p4 = f2d.CreatePoint(20, 11.5)
  Set p5 = f2d.CreatePoint(20, 76.5)
  Set p6 = f2d.CreatePoint(19.5, 77)
  Set p7 = f2d.CreatePoint(18.5, 77)
  Set p8 = f2d.CreatePoint(18, 76.5)
  Set e9 = f2d.CreateLine(18, 11.5, 20, 11.5)
  e9.StartPoint = p3
  e9.EndPoint = p4
  Set e10 = f2d.CreateLine(20, 11.5, 20, 76.5)
  e10.StartPoint = p4
  e10.EndPoint = p5
  Set e11 = f2d.CreateCircle(19.5, 76.5, 0.5, 0, 1.570796)
  e11.StartPoint = p5
  e11.EndPoint = p6
  Set e12 = f2d.CreateLine(19.5, 77, 18.5, 77)
  e12.StartPoint = p6
  e12.EndPoint = p7
  Set e13 = f2d.CreateCircle(18.5, 76.5, 0.5, 1.570796, 3.141593)
  e13.StartPoint = p7
  e13.EndPoint = p8
  Set e14 = f2d.CreateLine(18, 76.5, 18, 11.5)
  e14.StartPoint = p8
  e14.EndPoint = p3
  sk2.CloseEdition
  part1.InWorkObject = sk2
  part1.Update
  Set ft15 = sf.AddNewPad(sk2, 15.5)
  ft15.IsSymmetric = True
  ft15.Name = "Plate"
  rels.CreateFormula "F_Plate_half", "", ft15.FirstLimit.Dimension, "abs( ( WIDTH ) - ( 0mm ) ) / 2"
  part1.Update
  If Err.Number <> 0 Then log = log & "FAILED: " & stepName & " (" & Err.Description & ")" & vbCrLf: nFail = nFail + 1: Err.Clear
  stepName = "pad Rail_L"
  Set pl16 = hsf.AddNewPlaneOffset(part1.CreateReferenceFromObject(org.PlaneYZ), 0.5, False)
  hb.AppendHybridShape pl16
  pl16.Name = "Plane_Rail_L"
  rels.CreateFormula "F_Plane_Rail_L", "", pl16.Offset, "( ( 0mm ) + ( RAIL_W ) ) / 2"
  part1.InWorkObject = hb
  part1.Update
  part1.InWorkObject = body1
  Set sk17 = body1.Sketches.Add(part1.CreateReferenceFromObject(pl16))
